# ==============================================================================
# KalyanaConnect Monorepo - Git Ignore Rules
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local
*.pem
*.key
*.cert

# Always keep example env files tracked
!.env.example
!**/.env.example

# --- Build Outputs ---
dist/
**/dist/
build/
**/build/
out/
**/out/

# --- Next.js Framework ---
.next/
**/.next/
*.tsbuildinfo
next-env.d.ts

# --- Vercel ---
.vercel/
**/.vercel/

# --- Database & Prisma ---
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# --- File Uploads & Local Media ---
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/

# --- Logs & Process Outputs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
**/coverage/
.nyc_output/

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Monorepo & Build Tools ---
.turbo/
.cache/
**/node_modules/.cache/
.eslintcache
