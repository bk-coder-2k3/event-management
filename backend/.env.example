# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizhaspace?schema=public

# Security & JWT Secrets
JWT_ACCESS_SECRET=vizhaspace_super_secret_jwt_access_token_key_change_in_production_2026
JWT_REFRESH_SECRET=vizhaspace_super_secret_jwt_refresh_token_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=vizhaspace_cookie_secret_change_in_production_key_2026

# Storage Configuration (local or cloudinary)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudinary (Optional - when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Bootstrap Defaults
DEFAULT_ADMIN_EMAIL=admin@vizhaspace.in
DEFAULT_ADMIN_PASSWORD=AdminSecure#2026
DEFAULT_ADMIN_NAME="VizhaSpace Platform Admin"
