{
  "name": "vizhaspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VizhaSpace (vizhaspace.in) - Premier All-Events & Wedding Marketplace for Tamil Nadu",
  "workspaces": [
    "shared",
    "backend",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=@vizhaspace/customer",
    "dev:vendor": "npm run dev --workspace=@vizhaspace/vendor",
    "dev:admin": "npm run dev --workspace=@vizhaspace/admin",
    "dev": "npm run build --workspace=shared && concurrently -n \"BACKEND,CUSTOMER,VENDOR,ADMIN\" -c \"blue,green,magenta,yellow\" \"npm run dev:backend\" \"npm run dev:customer\" \"npm run dev:vendor\" \"npm run dev:admin\"",
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "build:customer": "npm run build --workspace=@vizhaspace/customer",
    "build:vendor": "npm run build --workspace=@vizhaspace/vendor",
    "build:admin": "npm run build --workspace=@vizhaspace/admin",
    "build": "npm run build:shared && npm run build:backend && npm run build:customer && npm run build:vendor && npm run build:admin",
    "test": "npm run test --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "bootstrap:admin": "npm run bootstrap:admin --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
