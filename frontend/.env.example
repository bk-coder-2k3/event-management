# ==============================================================================
# KalyanaConnect Frontend Environment Variables (Template)
# ==============================================================================

# Client-side API URL (exposed to browser via NEXT_PUBLIC_)
# In local development: /api/v1 (proxied via next.config.mjs rewrites) or http://localhost:5000/api/v1
# In production / Vercel: https://api.kalyanaconnect.com/api/v1 or /api/v1 (with rewrites)
NEXT_PUBLIC_API_URL=/api/v1

# Backend server URL for Next.js internal server-side rewrites & proxying
BACKEND_INTERNAL_URL=http://localhost:5000

